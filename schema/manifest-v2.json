{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schemas.obacht.dev/manifest-v2.json",
  "title": "Obacht Template Manifest v2",
  "description": "Declarative template manifest consumed by obacht-agent and obacht-registry.",
  "type": "object",
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "additionalProperties": false,
  "properties": {
    "apiVersion": {
      "type": "string",
      "const": "obacht.dev/v2"
    },
    "kind": {
      "type": "string",
      "const": "Template"
    },
    "metadata": { "$ref": "#/definitions/metadata" },
    "spec":     { "$ref": "#/definitions/spec" }
  },
  "definitions": {
    "metadata": {
      "type": "object",
      "required": ["name", "displayName", "version"],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*[a-z0-9]$",
          "description": "Kebab-case template id, unique within the registry."
        },
        "displayName":  { "type": "string", "minLength": 1 },
        "description":  { "type": "string" },
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+([-+][0-9A-Za-z.-]+)?$"
        },
        "author":  { "type": "string" },
        "license": { "type": "string" },
        "homepage": { "type": "string", "format": "uri" },
        "icon":    { "type": "string" },
        "tags":    { "type": "array", "items": { "type": "string" } },
        "trustLevel": {
          "type": "string",
          "enum": ["official", "community", "unverified"]
        }
      }
    },
    "spec": {
      "type": "object",
      "required": ["runtime"],
      "additionalProperties": false,
      "properties": {
        "minAgentVersion": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+([-+][0-9A-Za-z.-]+)?$"
        },
        "exclusivityGroup": { "type": "string" },
        "runtime":  { "$ref": "#/definitions/runtime" },
        "services": {
          "type": "array",
          "items": { "$ref": "#/definitions/service" }
        },
        "configSchema": {
          "type": "array",
          "items": { "$ref": "#/definitions/configField" }
        }
      }
    },
    "runtime": {
      "oneOf": [
        {
          "type": "object",
          "required": ["type", "container"],
          "additionalProperties": false,
          "properties": {
            "type":      { "const": "container" },
            "container": { "$ref": "#/definitions/containerRuntime" }
          }
        },
        {
          "type": "object",
          "required": ["type", "system"],
          "additionalProperties": false,
          "properties": {
            "type":   { "const": "system" },
            "system": { "$ref": "#/definitions/systemRuntime" }
          }
        }
      ]
    },
    "containerRuntime": {
      "type": "object",
      "required": ["image"],
      "additionalProperties": false,
      "properties": {
        "image":   { "type": "string", "minLength": 1 },
        "cmd":     { "type": "array",  "items": { "type": "string" } },
        "env":     { "type": "object", "additionalProperties": { "type": "string" } },
        "ports": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["host", "container"],
            "additionalProperties": false,
            "properties": {
              "host":      { "type": "integer", "minimum": 0, "maximum": 65535 },
              "container": { "type": "integer", "minimum": 1, "maximum": 65535 }
            }
          }
        },
        "volumes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["source", "target"],
            "additionalProperties": false,
            "properties": {
              "source":   { "type": "string" },
              "target":   { "type": "string" },
              "readOnly": { "type": "boolean" }
            }
          }
        },
        "network": { "type": "string" },
        "labels":  { "type": "object", "additionalProperties": { "type": "string" } }
      }
    },
    "systemRuntime": {
      "type": "object",
      "required": ["unitName", "unitTemplate"],
      "additionalProperties": false,
      "properties": {
        "unitName":     { "type": "string", "pattern": "\\.service$" },
        "unitTemplate": { "type": "string" },
        "files": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["path", "content"],
            "additionalProperties": false,
            "properties": {
              "path":    { "type": "string" },
              "mode":    { "type": "string", "pattern": "^0[0-7]{3}$" },
              "content": { "type": "string" }
            }
          }
        }
      }
    },
    "service": {
      "type": "object",
      "required": ["name", "targetType"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "targetType": {
          "type": "string",
          "enum": ["container_port", "host_port", "unix_socket"]
        },
        "targetPort": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "targetPath": { "type": "string" }
      },
      "allOf": [
        {
          "if":   { "properties": { "targetType": { "enum": ["container_port", "host_port"] } } },
          "then": { "required": ["targetPort"] }
        },
        {
          "if":   { "properties": { "targetType": { "const": "unix_socket" } } },
          "then": { "required": ["targetPath"] }
        }
      ]
    },
    "configField": {
      "type": "object",
      "required": ["key", "label", "type"],
      "additionalProperties": false,
      "properties": {
        "key":   { "type": "string", "pattern": "^[a-zA-Z_][a-zA-Z0-9_]*$" },
        "label": { "type": "string", "minLength": 1 },
        "type": {
          "type": "string",
          "enum": ["text", "number", "select", "boolean", "secret"]
        },
        "required":    { "type": "boolean" },
        "default":     {},
        "description": { "type": "string" },
        "options": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["value", "label"],
            "additionalProperties": false,
            "properties": {
              "value": { "type": "string" },
              "label": { "type": "string" }
            }
          }
        }
      },
      "allOf": [
        {
          "if":   { "properties": { "type": { "const": "select" } } },
          "then": { "required": ["options"] }
        }
      ]
    }
  }
}
