{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schemas.obacht.dev/manifest-v2.json",
  "title": "Obacht Template Manifest v2",
  "description": "Declarative template manifest consumed by obacht-agent and obacht-registry. Spec revision v2.1 introduces compose-runtime bundles, device compatibility, declared service interfaces and per-instance secrets (BREAKING vs v2.0 — every manifest must declare spec.minSpecVersion and spec.compatibility). Additive since: v2.2 immutable config/secret fields; v2.3 tag-only compose images + envConfigKey + ${cfg.X} structural placeholders; v2.4 macOS platform (the 'mac' device, 'darwin/arm64' architecture, compatibility.excludeDevices, and the system runtime's host_service flavor); v2.5 the optional spec.gettingStarted post-install note; v2.6 the typed config-field renderers 'timezone', 'email' and 'domain' (render-only — they resolve to the same string a 'text' field would, so the agent and api are unaffected); v2.7 the optional 'advanced' flag on config fields (render-only — Easy-Mode clients hide flagged fields, falling back to their default); v2.8 the Pi system-runtime flavors managed_service (digest-pinned host binary run as an agent-generated hardened systemd unit) and kiosk (marker for the agent-shipped kiosk session), compatibility.requiresFeatures (device-feature gating, e.g. a preinstalled desktop), and configField.optionsSource (render-only: select options populated from device-reported inventory such as detected cameras). v2.8 also WITHDRAWS the never-shipped free-form systemd flavor (unitName + unitTemplate): system templates never author unit text; registry and agent reject it.",
  "type": "object",
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "additionalProperties": false,
  "properties": {
    "apiVersion": { "type": "string", "const": "obacht.dev/v2" },
    "kind":       { "type": "string", "const": "Template" },
    "metadata":   { "$ref": "#/definitions/metadata" },
    "spec":       { "$ref": "#/definitions/spec" }
  },
  "definitions": {
    "metadata": {
      "type": "object",
      "required": ["name", "displayName", "version"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z][a-z0-9-]*[a-z0-9]$" },
        "displayName": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+([-+][0-9A-Za-z.-]+)?$" },
        "author": { "type": "string" },
        "license": { "type": "string" },
        "homepage": { "type": "string", "format": "uri" },
        "icon": { "type": "string" },
        "tags": { "type": "array", "items": { "type": "string" } },
        "trustLevel": { "type": "string", "enum": ["official", "community", "unverified"] }
      }
    },
    "spec": {
      "type": "object",
      "required": ["minSpecVersion", "compatibility", "runtime"],
      "additionalProperties": false,
      "properties": {
        "minSpecVersion": { "type": "string", "pattern": "^v\\d+\\.\\d+$" },
        "minAgentVersion": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+([-+][0-9A-Za-z.-]+)?$" },
        "exclusivityGroup": { "type": "string" },
        "compatibility": { "$ref": "#/definitions/compatibility" },
        "runtime": { "$ref": "#/definitions/runtime" },
        "services": { "type": "array", "items": { "$ref": "#/definitions/service" } },
        "configSchema": { "type": "array", "items": { "$ref": "#/definitions/configField" } },
        "secretsSchema": { "type": "array", "items": { "$ref": "#/definitions/secretField" } },
        "provides": { "type": "array", "items": { "$ref": "#/definitions/provideEntry" } },
        "consumes": { "type": "array", "items": { "$ref": "#/definitions/consumeEntry" } },
        "minSudoLevel": { "type": "string", "enum": ["none", "power"], "default": "none" },
        "secrets": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
          "uniqueItems": true
        },
        "gettingStarted": {
          "type": "string",
          "description": "Optional post-install note shown to the user after the service is installed (plain text / lightweight markdown). Purely informational; the agent never sees it. Added in spec v2.5."
        }
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["architectures"],
      "properties": {
        "devices": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["raspberry-pi-4", "raspberry-pi-5", "mac-mini-arm", "mac", "generic-x86_64", "generic-arm64"]
          }
        },
        "excludeDevices": {
          "type": "array",
          "description": "v2.4: device classes the template must NOT be offered on even if the architecture matches (clients filter on this).",
          "items": {
            "type": "string",
            "enum": ["raspberry-pi-4", "raspberry-pi-5", "mac-mini-arm", "mac", "generic-x86_64", "generic-arm64"]
          }
        },
        "architectures": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "enum": ["linux/arm64", "linux/amd64", "linux/arm/v7", "darwin/arm64"] }
        },
        "requiresFeatures": {
          "type": "array",
          "uniqueItems": true,
          "description": "v2.8: device features the template requires. The agent detects and reports device features; the api install-plan compat check, the client catalog filter AND the on-device install assertion all enforce requiresFeatures ⊆ reported features. Closed enum — widening it is a deliberate spec bump.",
          "items": { "type": "string", "enum": ["desktop-chromium", "wayland-compositor", "csi-or-usb-camera"] }
        },
        "os": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "minVersion": { "type": "string" }
            }
          }
        },
        "resources": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "minRamMb": { "type": "integer", "minimum": 32 },
            "minDiskMb": { "type": "integer", "minimum": 32 }
          }
        }
      }
    },
    "runtime": {
      "oneOf": [
        {
          "type": "object",
          "required": ["type", "container"],
          "additionalProperties": false,
          "properties": {
            "type": { "const": "container" },
            "container": { "$ref": "#/definitions/containerRuntime" }
          }
        },
        {
          "type": "object",
          "required": ["type", "compose"],
          "additionalProperties": false,
          "properties": {
            "type": { "const": "compose" },
            "compose": { "$ref": "#/definitions/composeRuntime" }
          }
        },
        {
          "type": "object",
          "required": ["type", "system"],
          "additionalProperties": false,
          "properties": {
            "type": { "const": "system" },
            "system": { "$ref": "#/definitions/systemRuntime" }
          }
        }
      ]
    },
    "containerRuntime": {
      "type": "object",
      "required": ["image"],
      "additionalProperties": false,
      "properties": {
        "image": { "type": "string", "minLength": 1 },
        "imageDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "cmd": { "type": "array", "items": { "type": "string" } },
        "env": { "type": "object", "additionalProperties": { "type": "string" } },
        "ports": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["host", "container"],
            "additionalProperties": false,
            "properties": {
              "host": { "type": "integer", "minimum": 0, "maximum": 65535 },
              "container": { "type": "integer", "minimum": 1, "maximum": 65535 }
            }
          }
        },
        "volumes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["source", "target"],
            "additionalProperties": false,
            "properties": {
              "source": { "type": "string" },
              "target": { "type": "string" },
              "readOnly": { "type": "boolean" }
            }
          }
        },
        "network": { "type": "string" },
        "labels": { "type": "object", "additionalProperties": { "type": "string" } }
      }
    },
    "composeRuntime": {
      "type": "object",
      "required": ["primaryService", "primaryPort", "body"],
      "additionalProperties": false,
      "properties": {
        "primaryService": { "type": "string", "minLength": 1 },
        "primaryPort": {
          "oneOf": [
            { "type": "integer", "minimum": 1, "maximum": 65535 },
            { "type": "string", "pattern": "^\\$\\{cfg\\.[a-zA-Z0-9_]+\\}$" }
          ]
        },
        "dataPath": { "type": "string" },
        "imageDigests": {
          "type": "object",
          "additionalProperties": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
        },
        "allowUnpinnedImages": { "type": "boolean" },
        "envConfigKey": { "type": "string" },
        "body": { "type": "string", "minLength": 1 }
      }
    },
    "systemRuntime": {
      "type": "object",
      "additionalProperties": false,
      "description": "Exactly one flavor: the v2.4 macOS host-service (host_service), the v2.8 Linux managed service (managed_service), or the v2.8 kiosk marker (kiosk). The pre-v2.8 free-form systemd flavor (unitName + unitTemplate) is withdrawn — no template ever shipped it; system templates never author unit text, the agent generates hardened units from the structured declaration.",
      "oneOf": [
        { "required": ["host_service"] },
        { "required": ["managed_service"] },
        { "required": ["kiosk"] }
      ],
      "properties": {
        "host_service": {
          "type": "object",
          "description": "v2.4 (macOS host-services): a launchd-managed host binary instead of a systemd unit. The agent verifies binary_digest before extract/exec.",
          "additionalProperties": false,
          "required": ["binary", "binary_url", "binary_digest"],
          "properties": {
            "kind": { "type": "string" },
            "binary": { "type": "string" },
            "binary_url": { "type": "string" },
            "binary_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
            "archive": { "type": "string", "enum": ["tgz"] },
            "args": { "type": "array", "items": { "type": "string" } },
            "env": { "type": "object", "additionalProperties": { "type": "string" } },
            "data_dir": { "type": "string" }
          }
        },
        "managed_service": {
          "type": "object",
          "description": "v2.8 (Raspberry Pi / Linux, requires spec.minSudoLevel: power): a digest-pinned host binary run as a hardened systemd unit that the AGENT generates (DynamicUser, DevicePolicy=closed + declared DeviceAllow, NoNewPrivileges, ProtectSystem=strict); the root helper independently re-validates the unit before installing it. The agent verifies binary_digest before extract/exec; the binary name must be on the agent's closed allowlist, the url host on the agent's download-host allowlist.",
          "additionalProperties": false,
          "required": ["binary", "binary_url", "binary_digest"],
          "properties": {
            "kind": { "type": "string" },
            "binary": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
            "binary_url": { "type": "string", "pattern": "^https://" },
            "binary_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
            "archive": { "type": "string", "enum": ["tgz"] },
            "args": { "type": "array", "items": { "type": "string" } },
            "env": { "type": "object", "additionalProperties": { "type": "string" } },
            "hardware": {
              "type": "object",
              "description": "Hardware access the generated unit grants the workload. Closed enums — widening them is a deliberate spec bump.",
              "additionalProperties": false,
              "properties": {
                "groups": { "type": "array", "uniqueItems": true, "items": { "type": "string", "enum": ["video", "render", "input"] } },
                "devices": { "type": "array", "uniqueItems": true, "items": { "type": "string", "enum": ["/dev/video*", "/dev/media*", "/dev/dri/*", "/dev/dma_heap/*"] } }
              }
            },
            "listen_ports": {
              "type": "array",
              "description": "Local ports the service binds (documentation + validation only; exposure happens exclusively via spec.services → device Caddy).",
              "items": { "type": "integer", "minimum": 1, "maximum": 65535 }
            }
          }
        },
        "kiosk": {
          "type": "object",
          "description": "v2.8 marker flavor (requires spec.minSudoLevel: power and compatibility.requiresFeatures [desktop-chromium, wayland-compositor]): the agent-shipped kiosk session (Chromium fullscreen on the device's preinstalled desktop). All privileged behaviour lives in the agent; the template contributes configSchema + files only.",
          "additionalProperties": false,
          "properties": {}
        },
        "files": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["path", "content"],
            "additionalProperties": false,
            "properties": {
              "path": { "type": "string" },
              "mode": { "type": "string", "pattern": "^0[0-7]{3}$" },
              "content": { "type": "string" }
            }
          }
        }
      }
    },
    "service": {
      "type": "object",
      "required": ["name", "targetType"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "targetType": { "type": "string", "enum": ["container_port", "host_port", "unix_socket"] },
        "targetService": { "type": "string", "minLength": 1 },
        "targetPort": {
          "oneOf": [
            { "type": "integer", "minimum": 1, "maximum": 65535 },
            { "type": "string", "pattern": "^\\$\\{cfg\\.[a-zA-Z0-9_]+\\}$" }
          ]
        },
        "targetPath": { "type": "string" },
        "appPath": {
          "type": "string",
          "pattern": "^/(?:[A-Za-z0-9._~-][A-Za-z0-9._~/-]*)?$",
          "description": "v2.8: when this service is bound at the domain root, redirect a bare '/' to this path — for apps that serve their entry page under a subpath (e.g. MediaMTX at '/cam/'). Absolute path, no scheme/host. Only the exact root is redirected; everything else proxies through. Ignored by clients/agents that predate the field."
        }
      },
      "allOf": [
        { "if": { "properties": { "targetType": { "enum": ["container_port", "host_port"] } } }, "then": { "required": ["targetPort"] } },
        { "if": { "properties": { "targetType": { "const": "unix_socket" } } }, "then": { "required": ["targetPath"] } }
      ]
    },
    "configField": {
      "type": "object",
      "required": ["key", "label", "type"],
      "additionalProperties": false,
      "properties": {
        "key": { "type": "string", "pattern": "^[a-zA-Z_][a-zA-Z0-9_]*$" },
        "label": { "type": "string", "minLength": 1 },
        "type": { "type": "string", "enum": ["text", "textarea", "number", "select", "boolean", "secret", "service_reference", "timezone", "email", "domain"] },
        "required": { "type": "boolean" },
        "default": {},
        "description": { "type": "string" },
        "options": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["value", "label"],
            "additionalProperties": false,
            "properties": { "value": { "type": "string" }, "label": { "type": "string" } }
          }
        },
        "optionsSource": {
          "type": "object",
          "description": "v2.8 (render-only, select fields, mutually exclusive with options): populate the select options from device-reported inventory instead of a static list. Clients must block the install while the inventory is empty or the device is offline — no silent free-text fallback. The agent and api treat the chosen value as a plain string, exactly like a static select.",
          "additionalProperties": false,
          "required": ["kind", "inventory"],
          "properties": {
            "kind": { "type": "string", "const": "device_inventory" },
            "inventory": { "type": "string", "enum": ["cameras"] }
          }
        },
        "interface": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "interfaceVersion": { "type": "string", "pattern": "^v\\d+$" },
        "fallback": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": { "type": "string", "enum": ["text", "secret"] },
            "placeholder": { "type": "string" },
            "default": { "type": "string" }
          }
        },
        "immutable": { "type": "boolean", "default": false, "description": "Spec v2.2: when true, the value is set at install time and cannot be changed via the post-install Configure UI. The api rejects install-plan submissions that try to mutate it." },
        "advanced": { "type": "boolean", "default": false, "description": "Spec v2.7: when true, clients in Easy Mode hide this field from the install/Configure UI (the install still uses the field's default). Render-only — the agent and api ignore it. Only set advanced on fields that have a usable default and are not required-without-default, otherwise Easy-Mode installs break." }
      },
      "allOf": [
        { "if": { "properties": { "type": { "const": "select" } } }, "then": { "anyOf": [{ "required": ["options"] }, { "required": ["optionsSource"] }] } },
        { "not": { "required": ["options", "optionsSource"] } },
        { "if": { "properties": { "type": { "const": "service_reference" } } }, "then": { "required": ["interface", "interfaceVersion"] } }
      ]
    },
    "secretField": {
      "type": "object",
      "required": ["key", "length"],
      "additionalProperties": false,
      "properties": {
        "key": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "length": { "type": "integer", "minimum": 8, "maximum": 256 },
        "charset": { "type": "string", "enum": ["alphanumeric", "alphanumeric_symbols", "hex", "base64", "base64_bytes"], "default": "alphanumeric" },
        "immutable": { "type": "boolean", "default": true, "description": "Spec v2.2: secrets are immutable by default once generated. Accepted for explicitness; setting false is currently not honoured by the agent (no rotation path)." }
      }
    },
    "provideEntry": {
      "type": "object",
      "required": ["interface", "version", "service", "port"],
      "additionalProperties": false,
      "properties": {
        "interface": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "version": { "type": "string", "pattern": "^v\\d+$" },
        "service": { "type": "string", "minLength": 1 },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "path": { "type": "string", "default": "/" },
        "auth": { "type": "string", "enum": ["none", "bearer_token", "basic"], "default": "none" }
      }
    },
    "consumeEntry": {
      "type": "object",
      "required": ["interface", "version", "configKey"],
      "additionalProperties": false,
      "properties": {
        "interface": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "version": { "type": "string", "pattern": "^v\\d+$" },
        "configKey": { "type": "string", "pattern": "^[a-zA-Z_][a-zA-Z0-9_]*$" }
      }
    }
  }
}
